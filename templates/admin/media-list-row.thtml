<tr>
    <td class="radio-admin__media-title">
        <strong class="radio-admin__ellipsis" title="{title_full}">{title}</strong>
        <div class="radio-admin__muted radio-admin__ellipsis" title="{filename_full}">{filename}</div>
    </td>
    <td class="radio-admin__nowrap">{media_type}</td>
    <td class="radio-admin__nowrap">{status}</td>
    <td class="radio-admin__availability">{availability}</td>
    <td class="radio-admin__nowrap">{source}</td>
    <td class="radio-admin__nowrap">{duration}</td>
    <td class="radio-admin__nowrap">{size}</td>
    <td class="radio-admin__nowrap">{modified}</td>
    <td class="radio-admin__actions"><a class="radio-admin__button" href="{edit_url}">{edit_label}</a></td>
</tr>
