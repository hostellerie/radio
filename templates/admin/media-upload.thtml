<form class="radio-admin-form" method="post" enctype="multipart/form-data" action="">
    <div class="radio-upload-dropzone" id="radio-upload-dropzone"
         data-drop-label="{batch_drop_label}"
         data-remove-label="{batch_remove_label}">
        <label for="radio-upload-file" class="radio-upload-dropzone__label">
            <strong>{batch_drop_title}</strong>
            <span>{batch_drop_text}</span>
        </label>
        <input type="file" id="radio-upload-file" name="audio_files[]" accept=".mp3,.m4a,.aac,.ogg,.wav,audio/*" multiple required>
    </div>
    <p class="radio-admin__muted">{batch_server_limit}</p>
    <div id="radio-upload-queue" class="radio-upload-queue" aria-live="polite"></div>
    <p id="radio-upload-batch-note" class="radio-admin__help radio-upload-batch-note" hidden>{batch_metadata_note}</p>

    <p><label>{title_label}<br>
        <input type="text" name="title" maxlength="255">
    </label></p>

    <p><label>{author_label}<br>
        <input type="text" name="author" maxlength="255">
    </label></p>

    <p><label>{series_title_label}<br>
        <input type="text" name="series_title" maxlength="255">
    </label></p>

    <p><label>{category_label}<br>
        <input type="text" name="category" maxlength="128">
    </label></p>

    <p><label>{collection_label}<br>
        <input type="text" name="collection_name" maxlength="255">
    </label></p>

    <p><label>{tags_label}<br>
        <input type="text" name="tags" maxlength="2048">
    </label><br>
    <small class="radio-admin__muted">{tags_help}</small></p>

    <p>
        <label>{season_number_label} <input type="number" name="season_number" min="0" value="0"></label>
        <label>{episode_number_label} <input type="number" name="episode_number" min="0" value="0"></label>
    </p>

    <p><label>{cover_label}<br>
        <input type="file" name="cover_file" accept=".jpg,.jpeg,.png,.webp,image/*">
    </label></p>

    <p><label>{description_label}<br>
        <textarea name="description" rows="4"></textarea>
    </label></p>

    <p><label>{type_label}<br>
        <select name="media_type">{media_type_options}</select>
    </label></p>

    <p><label>{duration_label}
        <input type="number" id="radio-upload-duration" name="duration" min="0" step="1" value="0">
    </label></p>

    <p>
        <label>{status_label} <select name="status">{status_options}</select></label>
        <input type="hidden" name="on_demand" value="0"><label><input type="checkbox" name="on_demand" value="1" checked> {on_demand_label}</label>
        <input type="hidden" name="broadcast" value="0"><label><input type="checkbox" name="broadcast" value="1" checked> {broadcast_label}</label>
        <input type="hidden" name="automatic_rotation" value="0"><label><input type="checkbox" name="automatic_rotation" value="1" checked> {automatic_rotation_label}</label>
        <label><input type="checkbox" name="allow_download" value="1" checked> {allow_download_label}</label>
    </p>
    <p class="radio-admin__muted">{automatic_rotation_help}</p>

    <fieldset>
        <legend>{permissions_label}</legend>
        <p><label>{group_label} {group_dropdown}</label></p>
        {permissions_html}
    </fieldset>

    <input type="hidden" name="{csrf_name}" value="{csrf_token}">
    <div class="radio-admin__toolbar">
        <button class="radio-admin__button radio-admin__button--primary" type="submit" name="upload_media" value="1">{submit_label}</button>
        <a class="radio-admin__button" href="{cancel_url}">{cancel_label}</a>
    </div>
</form>
