<form class="radio-admin-form" method="post" enctype="multipart/form-data" action="">
    <p><label>{source_kind_label}
        <select name="source_kind">{source_kind_options}</select>
    </label></p>

    <p><label>{source_url_label}<br>
        <input type="url" name="source_url" maxlength="2048" required>
    </label></p>

    <p><label>{title_label}<br>
        <input type="text" name="title" maxlength="255" required>
    </label></p>

    <p><label>{source_provider_label}<br>
        <input type="text" name="source_provider" maxlength="255">
    </label></p>

    <p><label>{source_external_id_label}<br>
        <input type="text" name="source_external_id" maxlength="255">
    </label></p>

    <p><label>{source_attribution_label}<br>
        <textarea name="source_attribution" rows="2"></textarea>
    </label></p>

    <p><label>{source_license_label}<br>
        <input type="text" name="source_license" maxlength="255">
    </label></p>

    <p><label>{description_label}<br>
        <textarea name="description" rows="3"></textarea>
    </label></p>

    <p>
        <label>{type_label} <select name="media_type">{media_type_options}</select></label>
        <label>{duration_label} <input type="number" name="duration" min="0" step="1" value="0"></label>
    </p>

    <p><label>{cover_label}<br>
        <input type="file" name="cover_file" accept=".jpg,.jpeg,.png,.webp,image/*">
    </label></p>

    <p>
        <label>{status_label} <select name="status">{status_options}</select></label>
        <input type="hidden" name="on_demand" value="0"><label><input type="checkbox" name="on_demand" value="1" checked> {on_demand_label}</label>
        <input type="hidden" name="broadcast" value="0"><label><input type="checkbox" name="broadcast" value="1" checked> {broadcast_label}</label>
    </p>

    <fieldset>
        <legend>{permissions_label}</legend>
        <p><label>{group_label} {group_dropdown}</label></p>
        {permissions_html}
    </fieldset>

    <input type="hidden" name="{csrf_name}" value="{csrf_token}">
    <div class="radio-admin__toolbar">
        <button class="radio-admin__button radio-admin__button--primary" type="submit" name="save_external_media" value="1">{submit_label}</button>
        <a class="radio-admin__button" href="{cancel_url}">{cancel_label}</a>
    </div>
</form>
